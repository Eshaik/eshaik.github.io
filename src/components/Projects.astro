---
import { content } from "../data/content";

const projects = content.en.projects;
---

<section id="projects" class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
  <p class="font-mono text-sm text-amber-400" data-i18n="projects.kicker">{projects.kicker}</p>
  <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl" data-i18n="projects.heading">{projects.heading}</h2>

  <div class="mt-10 grid gap-5 sm:grid-cols-2">
    {projects.items.map((item, i) => (
      <article class="group rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-amber-400/30 hover:bg-white/[0.05]">
        <h3 class="text-lg font-semibold text-white" data-i18n={`projects.items.${i}.title`}>{item.title}</h3>

        <div class="mt-3 flex flex-wrap gap-2">
          {item.tags.map((tag) => (
            <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 font-mono text-xs text-slate-400">
              {tag}
            </span>
          ))}
        </div>

        <p class="mt-4 text-sm leading-relaxed text-slate-400" data-i18n={`projects.items.${i}.description`}>
          {item.description}
        </p>

        <p class="mt-4 font-mono text-xs font-semibold text-amber-400">
          → <span data-i18n={`projects.items.${i}.impact`}>{item.impact}</span>
        </p>
      </article>
    ))}
  </div>
</section>
