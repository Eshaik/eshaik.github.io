---
import { content, socials } from "../data/content";

const contact = content.en.contact;
---

<section id="contact" class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
  <div class="rounded-3xl border border-white/10 bg-gradient-to-br from-amber-400/10 via-white/[0.02] to-transparent p-8 text-center sm:p-14">
    <p class="font-mono text-sm text-amber-400" data-i18n="contact.kicker">{contact.kicker}</p>
    <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl" data-i18n="contact.heading">{contact.heading}</h2>
    <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-slate-400" data-i18n="contact.text">
      {contact.text}
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={`mailto:${socials.email}`}
        data-i18n="contact.emailLabel"
        class="rounded-lg bg-amber-400 px-5 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-amber-300"
      >
        {contact.emailLabel}
      </a>
      <a
        href={socials.linkedin}
        target="_blank"
        rel="noreferrer"
        class="rounded-lg border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10"
      >
        LinkedIn
      </a>
      <a
        href={socials.github}
        target="_blank"
        rel="noreferrer"
        class="rounded-lg border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10"
      >
        GitHub
      </a>
    </div>

    <p class="mt-6 font-mono text-sm text-slate-500">{socials.email}</p>
  </div>
</section>
