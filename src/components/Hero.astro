---
import { content, socials } from "../data/content";

const hero = content.en.hero;
---

<section id="top" class="mx-auto max-w-5xl px-6 pb-20 pt-16 sm:pt-24">
  <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-amber-400/20 bg-amber-400/10 px-3 py-1 text-xs font-mono text-amber-300">
    <span class="relative flex h-2 w-2">
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"></span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-amber-400"></span>
    </span>
    <span data-i18n="hero.badge">{hero.badge}</span>
  </div>

  <p class="font-mono text-sm text-slate-400">
    <span data-i18n="hero.greeting">{hero.greeting}</span>
  </p>
  <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-white sm:text-6xl">
    <span data-i18n="hero.name">{hero.name}</span>
  </h1>
  <p class="mt-3 text-xl font-medium text-amber-400 sm:text-2xl" data-i18n="hero.title">
    {hero.title}
  </p>

  <p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-400 sm:text-lg" data-i18n="hero.summary">
    {hero.summary}
  </p>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <a
      href={`mailto:${socials.email}`}
      data-i18n="hero.ctaContact"
      class="rounded-lg bg-amber-400 px-5 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-amber-300"
    >
      {hero.ctaContact}
    </a>
    <a
      href={hero.resumeHref}
      data-i18n="hero.ctaResume"
      data-i18n-attr="href:hero.resumeHref"
      class="rounded-lg border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10"
    >
      {hero.ctaResume}
    </a>

    <div class="ml-1 flex items-center gap-3 text-slate-400">
      <a href={socials.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn" class="transition hover:text-white">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"></path>
        </svg>
      </a>
      <a href={socials.github} target="_blank" rel="noreferrer" aria-label="GitHub" class="transition hover:text-white">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <path d="M12 .5A11.5 11.5 0 0 0 .5 12.14c0 5.16 3.29 9.53 7.86 11.07.57.11.78-.25.78-.56 0-.28-.01-1.02-.02-2-3.2.71-3.88-1.57-3.88-1.57-.52-1.36-1.28-1.72-1.28-1.72-1.05-.73.08-.72.08-.72 1.16.08 1.77 1.22 1.77 1.22 1.03 1.79 2.7 1.27 3.36.97.1-.76.4-1.27.73-1.56-2.55-.3-5.24-1.31-5.24-5.83 0-1.29.45-2.34 1.19-3.16-.12-.3-.52-1.53.11-3.18 0 0 .97-.32 3.18 1.21a10.8 10.8 0 0 1 5.79 0c2.2-1.53 3.17-1.21 3.17-1.21.63 1.65.24 2.88.12 3.18.74.82 1.19 1.87 1.19 3.16 0 4.53-2.7 5.53-5.26 5.82.41.37.78 1.09.78 2.2 0 1.59-.01 2.87-.01 3.26 0 .31.21.68.79.56A11.5 11.5 0 0 0 23.5 12.14 11.5 11.5 0 0 0 12 .5z"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
