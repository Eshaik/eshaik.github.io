---
import { content } from "../data/content";

const skills = content.en.skills;
---

<section id="skills" class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
  <p class="font-mono text-sm text-amber-400" data-i18n="skills.kicker">{skills.kicker}</p>
  <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl" data-i18n="skills.heading">{skills.heading}</h2>

  <div class="mt-10 grid gap-6 sm:grid-cols-2">
    {skills.groups.map((group, i) => (
      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-300" data-i18n={`skills.groups.${i}.name`}>
          {group.name}
        </h3>
        <div class="mt-4 flex flex-wrap gap-2">
          {group.items.map((item) => (
            <span class="rounded-md border border-white/10 bg-white/5 px-2.5 py-1 font-mono text-xs text-slate-400">
              {item}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
