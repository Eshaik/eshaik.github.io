---
import { content } from "../data/content";

const footer = content.en.footer;
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-2 px-6 py-8 text-center text-sm text-slate-500 sm:flex-row sm:justify-between sm:text-left">
    <p class="font-mono">© {year} Eduin Shaik</p>
    <p data-i18n="footer.text">{footer.text}</p>
  </div>
</footer>
