---
import { content } from "../data/content";

const about = content.en.about;
---

<section id="about" class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
  <p class="font-mono text-sm text-amber-400" data-i18n="about.kicker">{about.kicker}</p>
  <h2 class="mt-2 text-3xl font-bold text-white sm:text-4xl" data-i18n="about.heading">{about.heading}</h2>

  <div class="mt-8 max-w-2xl space-y-4">
    {about.paragraphs.map((p, i) => (
      <p class="text-base leading-relaxed text-slate-400" data-i18n={`about.paragraphs.${i}`}>{p}</p>
    ))}
  </div>

  <div class="mt-8 flex items-start gap-3 rounded-xl border border-white/10 bg-white/[0.03] p-4">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mt-0.5 h-5 w-5 shrink-0 text-amber-400">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.44 60.44 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443" />
    </svg>
    <span class="text-sm text-slate-400" data-i18n="about.education">{about.education}</span>
  </div>
</section>
